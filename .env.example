# ==========================================
# Firebase Firestore - Production Keys
# ==========================================
# Ambil nilai ini dari Firebase Console:
# Project Settings > General > Your apps (Web App SDK configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDummyApiKeyForProduction123
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=world-order.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=world-order
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=world-order.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ==========================================
# Firebase Local Emulator (Opsional - khusus jika pakai emulator)
# ==========================================
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
